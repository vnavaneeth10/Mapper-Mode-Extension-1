{
  "manifest_version": 3,
  "name": "Controlled Queue Loader",
  "version": "2.0.0",
  "description": "Process URLs in a controlled queue, detect redirects, copy part numbers, import CSV/Excel, and export session reports.",
  "minimum_chrome_version": "114",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "mark-done": {
      "suggested_key": { "default": "Ctrl+Shift+W" },
      "description": "Mark current task as done"
    },
    "toggle-minimise": {
      "suggested_key": { "default": "Ctrl+Shift+M" },
      "description": "Minimise or restore the ribbon overlay"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}